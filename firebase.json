      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  },
  "auth": {
    "authorizedDomains": [
      "localhost",
      "heenari-9f2a6.web.app",
      "heenari-9f2a6.firebaseapp.com"
    ],
    "providers": {
      "anonymous": false,
      "emailPassword": false,
      "googleSignIn": {
        "oAuthBrandDisplayName": "희나리",
        "supportEmail": "liksn04@gmail.com"
      }
    }
  }
