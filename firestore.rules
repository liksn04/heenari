rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function verifiedGoogleUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // 관리자 판정의 유일한 신뢰 소스: Console에서만 쓰는 admins/{uid} 문서의 존재.
    function isAdmin() {
      return verifiedGoogleUser()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function optionalText(value, max) {
      return value == null || (value is string && value.size() >= 1 && value.size() <= max);
    }

    // 종일 일정: KST 00:00 시작(UTC 15:00 = 54_000_000ms), 종료 없음.
    // 시간 일정: 종료 없음 또는 시작 이후 72시간(259_200_000ms) 이내.
    function eventShape(e) {
      return e.keys().hasOnly(['title', 'description', 'location', 'startAt', 'endAt', 'allDay', 'tag', 'participantIds', 'createdBy', 'createdAt', 'updatedAt'])
        && e.keys().hasAll(['title', 'description', 'location', 'startAt', 'endAt', 'allDay', 'createdBy', 'createdAt', 'updatedAt'])
        && e.title is string && e.title.size() >= 1 && e.title.size() <= 60
        && optionalText(e.description, 500)
        && optionalText(e.location, 60)
        && e.startAt is timestamp
        && e.allDay is bool
        && e.createdBy is string
        && validTag(e)
        && validParticipants(e, e.createdBy)
        && (e.allDay
          ? (e.endAt == null && e.startAt.toMillis() % 86400000 == 54000000)
          : (e.endAt == null
            || (e.endAt is timestamp
              && e.endAt > e.startAt
              && e.endAt.toMillis() - e.startAt.toMillis() <= 259200000)));
    }

    // 합주 초대 참여자: 0..20명, 중복 없음, 작성자 제외. 없는 기존 문서도 허용한다.
    function validParticipants(d, authorId) {
      return !('participantIds' in d)
        || (d.participantIds is list
          && d.participantIds.size() <= 20
          && d.participantIds.toSet().size() == d.participantIds.size()
          && !d.participantIds.hasAny([authorId]));
    }

    // 태그: jam(합주)·lesson(강습)·etc(기타). 태그가 없는 기존 문서도 허용한다.
    function validTag(d) {
      return !('tag' in d) || d.tag in ['jam', 'lesson', 'etc'];
    }

    // 30분 = 1_800_000ms. 운영 시간 09:00–24:00 = 최대 30슬롯(15시간).
    // 합주(jam)만 최대 1시간(2슬롯)이고 강습·기타는 길이 제한이 없다.
    function reservationShape(r) {
      return r.keys().hasOnly(['title', 'note', 'ownerId', 'ownerName', 'startAt', 'endAt', 'dayKey', 'slotIds', 'tag', 'participantIds', 'createdAt', 'updatedAt'])
        && r.title is string && r.title.size() >= 1 && r.title.size() <= 40
        && (r.note == null || (r.note is string && r.note.size() <= 200))
        && r.ownerId is string
        && r.ownerName is string && r.ownerName.size() >= 1 && r.ownerName.size() <= 60
        && r.startAt is timestamp && r.endAt is timestamp
        && r.dayKey is string && r.dayKey.size() == 10
        && r.slotIds is list && r.slotIds.size() >= 1 && r.slotIds.size() <= 30
        && r.startAt.toMillis() % 1800000 == 0
        && r.endAt.toMillis() - r.startAt.toMillis() == r.slotIds.size() * 1800000
        && validTag(r)
        && validParticipants(r, r.ownerId)
        && (!('tag' in r) || r.tag != 'jam' || r.slotIds.size() <= 2);
    }

    // 슬롯 삭제는 대응 예약이 배치 이후 이 슬롯을 더 이상 소유하지 않을 때만 허용한다.
    function slotReleased(database, slotId, reservationId) {
      return !existsAfter(/databases/$(database)/documents/reservations/$(reservationId))
        || !(getAfter(/databases/$(database)/documents/reservations/$(reservationId)).data.slotIds.hasAny([slotId]));
    }

    match /reservations/{reservationId} {
      allow read: if verifiedGoogleUser();

      allow create: if verifiedGoogleUser()
        && reservationShape(request.resource.data)
        && isOwner(request.resource.data.ownerId)
        && request.resource.data.startAt > request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if verifiedGoogleUser()
        && reservationShape(request.resource.data)
        && isOwner(resource.data.ownerId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && resource.data.startAt > request.time
        && request.resource.data.startAt > request.time
        && request.resource.data.updatedAt == request.time;

      allow delete: if verifiedGoogleUser()
        && isOwner(resource.data.ownerId)
        && resource.data.startAt > request.time;
    }

    match /reservationSlots/{slotId} {
      allow read: if verifiedGoogleUser();

      allow create: if verifiedGoogleUser()
        && request.resource.data.keys().hasOnly(['reservationId', 'ownerId', 'dayKey', 'startsAt', 'createdAt'])
        && isOwner(request.resource.data.ownerId)
        && request.resource.data.reservationId is string && request.resource.data.reservationId.size() > 0
        && request.resource.data.dayKey is string && request.resource.data.dayKey.size() == 10
        && request.resource.data.startsAt is timestamp
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/reservations/$(request.resource.data.reservationId))
        && getAfter(/databases/$(database)/documents/reservations/$(request.resource.data.reservationId)).data.ownerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/reservations/$(request.resource.data.reservationId)).data.slotIds.hasAny([slotId]);

      allow update: if false;

      allow delete: if verifiedGoogleUser()
        && isOwner(resource.data.ownerId)
        && slotReleased(database, slotId, resource.data.reservationId);
    }

    match /admins/{uid} {
      allow read: if verifiedGoogleUser() && isOwner(uid);
      allow write: if false;
    }

    match /events/{eventId} {
      allow read: if verifiedGoogleUser();

      // 모든 회원이 본인 명의로 일정을 만든다. 수정·삭제는 작성자 본인 또는 관리자.
      allow create: if verifiedGoogleUser()
        && eventShape(request.resource.data)
        && isOwner(request.resource.data.createdBy)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if verifiedGoogleUser()
        && (isOwner(resource.data.createdBy) || isAdmin())
        && eventShape(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if verifiedGoogleUser()
        && (isOwner(resource.data.createdBy) || isAdmin());
    }

    // 회원 명부·프로필: 이름과 한줄소개(이메일 저장 안 함).
    match /members/{uid} {
      allow read: if verifiedGoogleUser();
      allow create, update: if verifiedGoogleUser()
        && isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'bio', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 60
        && (!('bio' in request.resource.data) || optionalText(request.resource.data.bio, 60))
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      // 푸시 토큰: 본인만. 알림 Worker는 IAM 권한으로 읽고 만료 토큰을 지운다.
      match /devices/{deviceId} {
        allow read, delete: if verifiedGoogleUser() && isOwner(uid);
        allow create, update: if verifiedGoogleUser()
          && isOwner(uid)
          && request.resource.data.keys().hasOnly(['token', 'updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() >= 1 && request.resource.data.token.size() <= 4096
          && request.resource.data.updatedAt == request.time;
      }
    }

    // 초대 알림 작업: 작성자가 같은 쓰기에서 만든 문서의 실제 참여자에게만. Worker가 처리 후 지운다.
    function authorAfter(collection, docId) {
      return collection == 'reservations'
        ? getAfter(/databases/$(database)/documents/reservations/$(docId)).data.ownerId
        : getAfter(/databases/$(database)/documents/events/$(docId)).data.createdBy;
    }

    match /pushJobs/{jobId} {
      allow read, update, delete: if false;
      allow create: if verifiedGoogleUser()
        && request.resource.data.keys().hasOnly(['kind', 'collection', 'docId', 'targetIds', 'createdBy', 'createdAt'])
        && request.resource.data.keys().hasAll(['kind', 'collection', 'docId', 'targetIds', 'createdBy', 'createdAt'])
        && request.resource.data.kind == 'invite'
        && request.resource.data.collection in ['reservations', 'events']
        && request.resource.data.docId is string
        && request.resource.data.docId.size() >= 1 && request.resource.data.docId.size() <= 128
        && request.resource.data.targetIds is list
        && request.resource.data.targetIds.size() >= 1 && request.resource.data.targetIds.size() <= 20
        && isOwner(request.resource.data.createdBy)
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/$(request.resource.data.collection)/$(request.resource.data.docId))
        && authorAfter(request.resource.data.collection, request.resource.data.docId) == request.auth.uid
        && getAfter(/databases/$(database)/documents/$(request.resource.data.collection)/$(request.resource.data.docId)).data.participantIds.hasAll(request.resource.data.targetIds);
    }

    match /settings/{settingId} {
      allow read: if verifiedGoogleUser();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
